#!/bin/sh
# Minimal bring-up initramfs for OnePlus Ace 2 Pro (xigua) mainline port.
#
# PURPOSE: make the kernel OBSERVABLE without physical UART. The kernel is
# given the vendor's DTB (ABL applies dtbo itself), so most drivers may not
# probe; but if the kernel reaches userspace at all, we can bring up a USB
# network gadget and get a shell. If it never reaches us, we learn that too --
# which is progress over the previous "cannot tell" situation.
#
# Design rules:
#   * never exit; always drop to a shell so the device stays reachable
#   * try several gadget functions (ECM is most reliable on Linux hosts,
#     RNDIS for Windows, NCM as another fallback)
#   * print progress to the console (ttyMSM0) as well, in case a UART is
#     attached later

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

log() {
    echo "[initramfs] $*"
    echo "[initramfs] $*" > /dev/kmsg 2>/dev/null
}

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
mount -t configfs none /sys/kernel/config 2>/dev/null
mount -t tmpfs none /tmp 2>/dev/null

log "boot: $(uname -a)"
log "cmdline: $(cat /proc/cmdline 2>/dev/null)"

# ---------------------------------------------------------------- network up
# Bring up the gadget. Returns 0 if a UDC was bound.
GADGET=/sys/kernel/config/usb_gadget/g1

find_udc() {
    for u in /sys/class/udc/*; do
        [ -e "$u" ] || continue
        echo "$(basename "$u")"
        return 0
    done
    return 1
}

udc_name() {
    local u
    u=$(find_udc) || return 1
    echo "$u"
}

setup_gadget() {
    local func="$1"      # rndis | ecm | ncm
    local addr="${2:-02:1a:11:00:00:01}"

    rm -rf "$GADGET" 2>/dev/null
    mkdir -p "$GADGET" || return 1
    cd "$GADGET" || return 1

    echo 0x1d6b > idVendor          # Linux Foundation
    echo 0x0104 > idProduct         # Multifunction Composite Gadget
    echo 0x0100 > bcdDevice
    echo 0x0200 > bcdUSB

    mkdir -p strings/0x409
    echo "0123456789" > strings/0x409/serialnumber
    echo "PJA110"      > strings/0x409/manufacturer
    echo "xigua-bringup" > strings/0x409/product

    mkdir -p configs/c.1/strings/0x409
    echo "bringup" > configs/c.1/strings/0x409/configuration
    echo 250       > configs/c.1/MaxPower

    mkdir -p "functions/$func.usb0" || return 1
    if [ "$func" = "rndis" ]; then
        echo "$addr" > functions/rndis.usb0/dev_addr
        # Windows-friendly descriptors
        echo "RNDIS" > functions/rndis.usb0/os_desc/interface.rndis/compatible_id 2>/dev/null
        echo "5162001" > functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id 2>/dev/null
    else
        echo "$addr" > "functions/$func.usb0/dev_addr"
    fi
    ln -s "functions/$func.usb0" configs/c.1/ 2>/dev/null

    local udc
    udc=$(udc_name) || { log "no UDC found (usb controller not probed?)"; return 1; }
    echo "$udc" > UDC || return 1
    log "gadget bound: func=$func udc=$udc"
    return 0
}

# Bring the host-side interface up with a fixed address.
addr_iface() {
    local iface="$1"
    ip link set "$iface" up 2>/dev/null
    ip addr add 172.16.42.1/24 dev "$iface" 2>/dev/null
    log "iface $iface up, 172.16.42.1/24"
}

wait_iface() {
    local tries=0
    while [ $tries -lt 30 ]; do
        for i in /sys/class/net/usb*; do
            [ -e "$i" ] || continue
            addr_iface "$(basename "$i")"
            return 0
        done
        tries=$((tries+1))
        sleep 0.2
    done
    return 1
}

log "--- attempting USB network gadget ---"
BOUND=""
for f in ecm rndis ncm; do
    log "trying $f ..."
    if setup_gadget "$f"; then
        if wait_iface; then
            BOUND="$f"
            break
        fi
        log "$f bound but no netdev appeared; trying next"
    fi
done

if [ -n "$BOUND" ]; then
    log "USB network up via $BOUND"
    # DHCP-less: host must use 172.16.42.2/24. Also start a telnetd for a
    # shell that works even without ssh on the host side.
    if command -v telnetd >/dev/null 2>&1; then
        telnetd -l /bin/sh -p 23 2>/dev/null && log "telnetd on 172.16.42.1:23"
    fi
    if command -v udhcpd >/dev/null 2>&1; then
        printf 'start 172.16.42.2\nend 172.16.42.10\ninterface usb0\nlease_file /tmp/leases\npidfile /tmp/udhcpd.pid\n' > /tmp/udhcpd.conf
        udhcpd /tmp/udhcpd.conf 2>/dev/null && log "udhcpd running"
    fi
else
    log "NO USB network could be brought up"
    log "UDC list: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
fi

# ------------------------------------------------------- evidence collection
log "--- environment summary (for later inspection) ---"
log "mmcblk/ufs: $(ls /dev/ufs* /dev/sd* /dev/mmcblk* 2>/dev/null | tr '\n' ' ')"
log "console:    $(ls /dev/ttyMSM* /dev/ttyAMA* 2>/dev/null | tr '\n' ' ')"

# keep the box alive and inspectable
log "dropping to shell (serial first, then console)"
if [ -c /dev/ttyMSM0 ]; then
    setsid sh -c 'exec sh </dev/ttyMSM0 >/dev/ttyMSM0 2>&1' 2>/dev/null &
fi

# --------------------------------------------------------------------------
# OBSERVABILITY: make "did the kernel reach userspace?" a binary signal.
#
# The problem this solves: with no UART, "our kernel died in early boot" and
# "our kernel booted fine but its USB peripheral never came up" look IDENTICAL --
# both end with the phone quietly returning to Android.
#
# So if USB did not come up, /init now forces one of three unmistakable outcomes.
# Every one of them is impossible for a stock Android boot, and every one is
# visible from the host with no extra hardware:
#
#   stage 2  PSCI power-off      -> phone goes dark and STAYS dark
#   stage 3  sysrq reboot        -> phone reboots over and over, never reaching
#                                   Android
#   stage 4  busy loop           -> phone stays awake but never boots Android and
#                                   never offers adb
#
# and, contrastingly:
#   Android returns with its own adb (kernel 5.15) -> our kernel DIED EARLY
#
# So all four cases are distinguishable purely by watching the host. Stages 2-4
# need no storage, no display and no USB -- only PSCI, which is the very first
# thing any arm64 kernel sets up.
# --------------------------------------------------------------------------
if [ -n "$BOUND" ]; then
    log "USB is up; staying alive for interactive use (NOT signalling)"
else
    log "=== NO USB: /init RAN, so signalling that userspace was reached ==="
    log "--- stage 2: PSCI power-off (phone should go dark and stay dark)"

    # let the log lines settle into any console/pstore first
    sleep 3

    if command -v poweroff >/dev/null 2>&1; then
        poweroff -f 2>/dev/null && log "poweroff returned (unexpected)"
    fi

    log "--- stage 3: sysrq power-off, then sysrq reboot (reboot loop)"
    echo o > /proc/sysrq-trigger 2>/dev/null
    sleep 2
    echo b > /proc/sysrq-trigger 2>/dev/null
    sleep 2

    log "--- stage 4: neither took; looping forever while staying visible"
    log "    (if the phone never returns to Android, our kernel certainly ran)"
    while true; do
        # keep retrying the hard power-off; if PSCI is missing entirely this
        # simply never succeeds, and the loop itself is the signal
        poweroff -f 2>/dev/null
        sleep 5
    done
fi

# If an init was passed on the cmdline, hand over; otherwise stay alive so the
# device remains reachable.
if [ -x /sbin/init ]; then
    exec /sbin/init
fi

while true; do
    sleep 3600
done
