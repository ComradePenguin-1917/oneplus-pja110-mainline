+#include "pja110-ap-gauge.h"
+
+/* Gated downstream initialization adapted from oplus_chg_hw_init. */
+static int qcom_battmgr_pja110_init(struct qcom_battmgr *b)
+{
+	int ret;
+
+	if (!pja110_charger_init || !of_machine_is_compatible("oneplus,xigua"))
+		return 0;
+	if (b->variant != QCOM_BATTMGR_SM8350 || !b->service_up)
+		return -ENODEV;
+	ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0);
+	if (ret || !b->usb.online)
+		return ret ? ret : -ENOLINK;
+	ret = pja110_ap_gauge_check(b->dev);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_GET, USB_CURR_MAX, 0);
+	if (ret || b->usb.current_max < 500000)
+		return ret ? ret : -ERANGE;
+	/* UINT_MAX is the documented OEM unsuspend sentinel, not an ICL. */
+	ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_SET,
+					     USB_INPUT_CURR_LIMIT, U32_MAX);
+	dev_info(b->dev, "PJA110 unsuspend response: %d\n", ret);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_SET,
+					     USB_INPUT_CURR_LIMIT, 500000);
+	dev_info(b->dev, "PJA110 500mA vote response: %d\n", ret);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_SET,
+					     BATT_CHG_EN, 1);
+	dev_info(b->dev, "PJA110 charge-enable response: %d\n", ret);
+	return ret;
 }
 
