/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "OnePlus Ace 2 Pro";
	compatible = "oneplus,xigua\0qcom,sm8550";
	chassis-type = "handset";
	qcom,msm-id = <0x207 0x20000 0x207 0x10000 0x218 0x20000 0x218 0x10000>;
	qcom,board-id = <0x10008 0x00>;

	wcn7850-pmu {
		vddrfa1p8-supply = <0xd4>;
		vddrfa1p2-supply = <0xd6>;
		vdddig-supply = <0xd8>;
		vddaon-supply = <0x1aa>;
		vddio-supply = <0xc8>;
		vdd-supply = <0x1ab>;
		bt-enable-gpios = <0x78 0x51 0x00>;
		wlan-enable-gpios = <0x78 0x50 0x00>;
		pinctrl-0 = <0x1f6 0x1f7 0x1f8>;
		pinctrl-names = "default";
		compatible = "qcom,wcn7850-pmu";

		regulators {

			ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0x202>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0x201>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
				phandle = <0x200>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x1ff>;
			};

			ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x1fe>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
				phandle = <0x1fd>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
				phandle = <0x1fc>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x1fb>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
				phandle = <0x1fa>;
			};

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
				phandle = <0x1f9>;
			};
		};
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";
		phandle = <0xfa>;
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			phandle = <0xd1>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			phandle = <0x2a>;
		};

		bi-tcxo-div2-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			clocks = <0x02 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x29>;
		};

		bi-tcxo-ao-div2-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			clocks = <0x02 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0xac>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x00 0x00>;
			clocks = <0x03 0x00>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			power-domains = <0x05>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			#cooling-cells = <0x02>;
			phandle = <0x15>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x04>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x06>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x00 0x100>;
			clocks = <0x03 0x00>;
			enable-method = "psci";
			next-level-cache = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x00 0x200>;
			clocks = <0x03 0x00>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			#cooling-cells = <0x02>;
			phandle = <0x17>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x00 0x300>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x0b>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0x10e>;
			#cooling-cells = <0x02>;
			phandle = <0x18>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x00 0x400>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x0d>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0x10e>;
			#cooling-cells = <0x02>;
			phandle = <0x19>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0d>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a710";
			reg = <0x00 0x500>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x0f>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0x10e>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0f>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a710";
			reg = <0x00 0x600>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x11>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0x10e>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x11>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x3";
			reg = <0x00 0x700>;
			clocks = <0x03 0x02>;
			enable-method = "psci";
			next-level-cache = <0x13>;
			power-domains = <0x14>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x02>;
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x24c>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x13>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};

				core3 {
					cpu = <0x18>;
				};

				core4 {
					cpu = <0x19>;
				};

				core5 {
					cpu = <0x1a>;
				};

				core6 {
					cpu = <0x1b>;
				};

				core7 {
					cpu = <0x1c>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "silver-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x226>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0x1a2c>;
				local-timer-stop;
				phandle = <0x22>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x514>;
				min-residency-us = <0x1fc8>;
				local-timer-stop;
				phandle = <0x23>;
			};

			cpu-sleep-2-0 {
				compatible = "arm,idle-state";
				idle-state-name = "goldplus-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x546>;
				min-residency-us = <0x1d38>;
				local-timer-stop;
				phandle = <0x24>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x2ee>;
				exit-latency-us = <0x92e>;
				min-residency-us = <0x23b8>;
				phandle = <0x25>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100c344>;
				entry-latency-us = <0xaf0>;
				exit-latency-us = <0x1130>;
				min-residency-us = <0x27a6>;
				phandle = <0x26>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8550\0qcom,scm";
			qcom,dload-mode = <0x1d 0x19000>;
			interconnects = <0x1e 0x02 0x00 0x1f 0x01 0x00>;
			phandle = <0xfb>;
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8550-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x20>;
		phandle = <0x32>;
	};

	interconnect-1 {
		compatible = "qcom,sm8550-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x20>;
		phandle = <0x1f>;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0x00 0xa0000000 0x00 0x00>;
	};

	pmu-a510 {
		compatible = "arm,cortex-a510-pmu";
		interrupts = <0x01 0x07 0x08>;
	};

	pmu-a710 {
		compatible = "arm,cortex-a710-pmu";
		interrupts = <0x01 0x07 0x08>;
	};

	pmu-a715 {
		compatible = "arm,cortex-a715-pmu";
		interrupts = <0x01 0x07 0x08>;
	};

	pmu-x3 {
		compatible = "arm,cortex-x3-pmu";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x05>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x08>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x0a>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x0c>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x0e>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x10>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x12>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x24>;
			phandle = <0x14>;
		};

		power-domain-cluster {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x25 0x26>;
			phandle = <0x21>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xfc>;

		hyp-region@80000000 {
			reg = <0x00 0x80000000 0x00 0xa00000>;
			no-map;
			phandle = <0xfd>;
		};

		cpusys-vm-region@80a00000 {
			reg = <0x00 0x80a00000 0x00 0x400000>;
			no-map;
			phandle = <0xfe>;
		};

		xbl-sc-region@d8100000 {
			reg = <0x00 0xd8100000 0x00 0x40000>;
			no-map;
			phandle = <0xff>;
		};

		xbl-dt-log-merged-region@81a00000 {
			reg = <0x00 0x81a00000 0x00 0x260000>;
			no-map;
			phandle = <0x100>;
		};

		aop-cmd-db-region@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x81c60000 0x00 0x20000>;
			no-map;
			phandle = <0x101>;
		};

		aop-config-merged-region@81c80000 {
			reg = <0x00 0x81c80000 0x00 0x74000>;
			no-map;
			phandle = <0x102>;
		};

		smem@81d00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x81d00000 0x00 0x200000>;
			hwlocks = <0x27 0x03>;
			no-map;
			phandle = <0x103>;
		};

		adsp-mhi-region@81f00000 {
			reg = <0x00 0x81f00000 0x00 0x20000>;
			no-map;
			phandle = <0x104>;
		};

		global-sync-region@82600000 {
			reg = <0x00 0x82600000 0x00 0x100000>;
			no-map;
			phandle = <0x105>;
		};

		tz-stat-region@82700000 {
			reg = <0x00 0x82700000 0x00 0x100000>;
			no-map;
			phandle = <0x106>;
		};

		mpss-region@8a800000 {
			reg = <0x00 0x8a800000 0x00 0x10800000>;
			no-map;
			phandle = <0x89>;
		};

		q6-mpss-dtb-region@9b000000 {
			reg = <0x00 0x9b000000 0x00 0x80000>;
			no-map;
			phandle = <0x8a>;
		};

		ipa-fw-region@9b080000 {
			reg = <0x00 0x9b080000 0x00 0x10000>;
			no-map;
			phandle = <0x107>;
		};

		ipa-gsi-region@9b090000 {
			reg = <0x00 0x9b090000 0x00 0xa000>;
			no-map;
			phandle = <0x108>;
		};

		gpu-micro-code-region@9b09a000 {
			reg = <0x00 0x9b09a000 0x00 0x2000>;
			no-map;
			phandle = <0x81>;
		};

		spss-region@9b100000 {
			reg = <0x00 0x9b100000 0x00 0x180000>;
			no-map;
			phandle = <0x109>;
		};

		spu-tz-shared-region@9b280000 {
			reg = <0x00 0x9b280000 0x00 0x60000>;
			no-map;
			phandle = <0x10a>;
		};

		spu-modem-shared-region@9b2e0000 {
			reg = <0x00 0x9b2e0000 0x00 0x20000>;
			no-map;
			phandle = <0x10b>;
		};

		camera-region@9b300000 {
			reg = <0x00 0x9b300000 0x00 0x800000>;
			no-map;
			phandle = <0x10c>;
		};

		video-region@9bb00000 {
			reg = <0x00 0x9bb00000 0x00 0x700000>;
			no-map;
			phandle = <0x10d>;
		};

		cvp-region@9c200000 {
			reg = <0x00 0x9c200000 0x00 0x700000>;
			no-map;
			phandle = <0x10e>;
		};

		cdsp-region@9c900000 {
			reg = <0x00 0x9c900000 0x00 0x2000000>;
			no-map;
			phandle = <0xdd>;
		};

		q6-cdsp-dtb-region@9e900000 {
			reg = <0x00 0x9e900000 0x00 0x80000>;
			no-map;
			phandle = <0xde>;
		};

		q6-adsp-dtb-region@9e980000 {
			reg = <0x00 0x9e980000 0x00 0x80000>;
			no-map;
			phandle = <0x91>;
		};

		adspslpi-region@9ea00000 {
			reg = <0x00 0x9ea00000 0x00 0x4880000>;
			no-map;
			phandle = <0x90>;
		};

		rmtfs-region@d4a80000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0xd4a80000 0x00 0x280000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
			phandle = <0x10f>;
		};

		mpss-dsm-region@d4d00000 {
			reg = <0x00 0xd4d00000 0x00 0x3300000>;
			no-map;
			phandle = <0x8b>;
		};

		tz-reserved-region@d8000000 {
			reg = <0x00 0xd8000000 0x00 0x100000>;
			no-map;
			phandle = <0x110>;
		};

		cpucp-fw-region@d8140000 {
			reg = <0x00 0xd8140000 0x00 0x1c0000>;
			no-map;
			phandle = <0x111>;
		};

		qtee-region@d8300000 {
			reg = <0x00 0xd8300000 0x00 0x500000>;
			no-map;
			phandle = <0x112>;
		};

		hwfence-shbuf-region@e6440000 {
			reg = <0x00 0xe6440000 0x00 0x279000>;
			no-map;
			phandle = <0x113>;
		};

		trust-ui-vm-region@f3800000 {
			no-map;
			reg = <0x00 0xf3800000 0x00 0x40ee000>;
			phandle = <0x114>;
		};

		trust-ui-vm-dump@f78ee000 {
			no-map;
			reg = <0x00 0xf78ee000 0x00 0x1000>;
			phandle = <0x115>;
		};

		trust-ui-vm-qrtr@f78ef000 {
			no-map;
			reg = <0x00 0xf78ef000 0x00 0x9000>;
			phandle = <0x116>;
		};

		trust-ui-vm-vblk0-ring@f78f8000 {
			no-map;
			reg = <0x00 0xf78f8000 0x00 0x4000>;
