		pm8550vs-d-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0xf2>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};
		};

		pm8550vs-e-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0xf3>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};
		};

		pm8550vs-g-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0xf4>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};
		};

		pmr735d-k-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0xf5>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		phandle = <0x1ec>;
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0xf6>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	aliases {
		serial0 = "/soc@0/geniqup@ac0000/serial@a9c000";
		serial1 = "/soc@0/geniqup@8c0000/serial@898000";
	};

	memory {
		device_type = "memory";
		ddr_device_type = <0x08>;
		reg = <0x00 0x80000000 0x00 0xe00000 0x00 0x811d0000 0x00 0x56f90000 0x00 0xd8800000 0x00 0x00 0x00 0xe1bb0000 0x00 0x1e450000 0x08 0x80000000 0x00 0x38700000 0x08 0xc0000000 0x01 0x40000000 0x0a 0x00 0x02 0x00>;
		phandle = <0x1ed>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xf7>;

		key-volume-down {
			label = "Volume Down";
			linux,code = <0x72>;
			gpios = <0xc6 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,sm8550-pmic-glink\0qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x78 0x0b 0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xf8>;
						phandle = <0xc4>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0xf9>;
						phandle = <0xc0>;
					};
				};
			};
		};
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xd3>;
	};

